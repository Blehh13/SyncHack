# --- Database ---
DATABASE_URL="postgresql://user:password@host:5432/synchack?sslmode=require"

# --- NextAuth ---
# Generate with: npx auth secret
AUTH_SECRET=""
# These MUST come from the GitHub App (not a standalone OAuth App),
# because the dashboard calls /user/installations.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# --- GitHub App ---
GITHUB_APP_ID=""
# PEM contents on one line, real newlines replaced with the two characters \n
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# --- Gemini ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# --- Local development ---
# Set to "true" to exercise the pipeline without calling GitHub
MOCK_GITHUB="false"
